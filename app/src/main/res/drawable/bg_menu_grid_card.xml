<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FF25364D"
                android:endColor="#FF172333"
                android:angle="270" />
            <corners android:radius="14dp" />
            <stroke android:width="1.5dp" android:color="#66FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#E6152132"
                android:endColor="#E60D1520"
                android:angle="270" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#33425A78" />
        </shape>
    </item>
</selector>
