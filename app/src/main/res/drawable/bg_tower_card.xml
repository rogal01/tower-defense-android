<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FF2A3B52"
                android:endColor="#FF182434"
                android:angle="270" />
            <corners android:radius="10dp" />
            <stroke android:width="1.5dp" android:color="#80FFD700" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#660E1622" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#26374D" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#E61A2638"
                android:endColor="#E6101824"
                android:angle="270" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#334B6886" />
        </shape>
    </item>
</selector>
