<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="32dp">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🏰"
        android:textSize="72sp"
        android:gravity="center"
        android:layout_marginTop="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/gold"
        android:textSize="40sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/menu_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginTop="4dp" />

    <!-- High Score -->
    <TextView
        android:id="@+id/text_high_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/gold"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginTop="16dp" />

    <!-- Difficulty selector -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/difficulty_label"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btn_easy"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:text="@string/difficulty_easy"
            android:textSize="14sp"
            android:backgroundTint="#4CAF50" />

        <Button
            android:id="@+id/btn_normal"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:text="@string/difficulty_normal"
            android:textSize="14sp"
            android:backgroundTint="#FF9800" />

        <Button
            android:id="@+id/btn_hard"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:text="@string/difficulty_hard"
            android:textSize="14sp"
            android:backgroundTint="#F44336" />
    </LinearLayout>

    <!-- Endless Mode button (primary play mode) -->
    <Button
        android:id="@+id/btn_endless"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="24dp"
        android:text="♾️ ENDLESS MODE"
        android:textSize="22sp"
        android:textStyle="bold"
        android:backgroundTint="@color/gold"
        android:textColor="@color/bg_dark" />

    <!-- Continue saved game -->
    <Button
        android:id="@+id/btn_continue"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:text="▶️ CONTINUE"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#4CAF50"
        android:textColor="@color/bg_dark"
        android:visibility="gone" />

    <!-- Endless high wave -->
    <TextView
        android:id="@+id/text_endless_record"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#E040FB"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginTop="4dp" />

    <!-- Campaign button -->
    <Button
        android:id="@+id/btn_campaign"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:text="@string/campaign"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#FF9800"
        android:textColor="@color/bg_dark" />

    <!-- Boss Rush button -->
    <Button
        android:id="@+id/btn_boss_rush"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:text="💀 BOSS RUSH"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#D50000"
        android:textColor="@android:color/white" />

    <!-- Boss Rush high wave -->
    <TextView
        android:id="@+id/text_boss_rush_record"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#D50000"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginTop="4dp" />

    <!-- Randomizer button -->
    <Button
        android:id="@+id/btn_randomizer"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:text="🎲 RANDOMIZER"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#AA00FF"
        android:textColor="@android:color/white" />

    <!-- Settings button -->
    <Button
        android:id="@+id/btn_settings"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:text="@string/settings"
        android:textSize="16sp"
        android:textColor="@color/text_secondary" />

    <!-- Skill Tree button -->
    <Button
        android:id="@+id/btn_skill_tree"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="@string/skill_tree"
        android:textSize="16sp"
        android:backgroundTint="#00E5FF"
        android:textColor="@color/bg_dark" />

    <!-- Statistics button -->
    <Button
        android:id="@+id/btn_stats"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="@string/statistics"
        android:textSize="16sp"
        android:textColor="@color/text_secondary" />

    <!-- Achievements button -->
    <Button
        android:id="@+id/btn_achievements"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="@string/achievements"
        android:textSize="16sp"
        android:textColor="@color/text_secondary" />

    <!-- Daily Challenge button -->
    <Button
        android:id="@+id/btn_daily"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="\uD83C\uDFAF Daily Challenge"
        android:textSize="16sp"
        android:backgroundTint="#FFAB00"
        android:textColor="@color/bg_dark" />

    <!-- Help button -->
    <Button
        android:id="@+id/btn_help"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="\uD83D\uDCD6 Help &amp; Mechanics"
        android:textSize="16sp"
        android:textColor="@color/text_secondary" />

    <!-- Diamond counter -->
    <TextView
        android:id="@+id/text_diamonds"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#00E5FF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp" />

</LinearLayout>
</ScrollView>
