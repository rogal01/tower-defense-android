<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="32dp">

    <!-- Language toggle -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_gravity="end"
        android:layout_marginBottom="4dp">
        <Button
            android:id="@+id/btn_lang_en"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:text="🇺🇸"
            android:textSize="18sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:backgroundTint="#33FFFFFF"
            android:layout_marginEnd="4dp" />
        <Button
            android:id="@+id/btn_lang_pl"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:text="🇵🇱"
            android:textSize="18sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:backgroundTint="#33FFFFFF" />
    </LinearLayout>

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🏰"
        android:textSize="72sp"
        android:gravity="center"
        android:layout_marginTop="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/gold"
        android:textSize="40sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/menu_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginTop="4dp" />

    <!-- High Score -->
    <TextView
        android:id="@+id/text_high_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/gold"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginTop="16dp" />

    <!-- Difficulty is chosen inside Endless popup — no standalone selector -->

    <!-- Campaign button (primary) -->
    <Button
        android:id="@+id/btn_campaign"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="24dp"
        android:text="@string/campaign"
        android:textSize="22sp"
        android:textStyle="bold"
        android:backgroundTint="#FF9800"
        android:textColor="@color/bg_dark" />

    <!-- Endless Mode button (primary play mode) -->
    <Button
        android:id="@+id/btn_endless"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="8dp"
        android:text="@string/endless_mode"
        android:textSize="22sp"
        android:textStyle="bold"
        android:backgroundTint="@color/gold"
        android:textColor="@color/bg_dark" />

    <!-- Continue saved game -->
    <Button
        android:id="@+id/btn_continue"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:text="@string/continue_game"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#4CAF50"
        android:textColor="@color/bg_dark"
        android:visibility="gone" />

    <!-- Endless high wave -->
    <TextView
        android:id="@+id/text_endless_record"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#E040FB"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginTop="4dp" />

    <!-- Boss Rush high wave -->
    <TextView
        android:id="@+id/text_boss_rush_record"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#D50000"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginTop="4dp" />

    <!-- More Modes — expandable toggle -->
    <Button
        android:id="@+id/btn_more_modes"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:text="\u25B6 More Modes"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#546E7A"
        android:textColor="@android:color/white" />

    <!-- Collapsible modes container -->
    <LinearLayout
        android:id="@+id/modes_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Boss Rush button -->
        <Button
            android:id="@+id/btn_boss_rush"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:text="@string/boss_rush"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#D50000"
            android:textColor="@android:color/white" />

        <!-- Randomizer button -->
        <Button
            android:id="@+id/btn_randomizer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:text="@string/randomizer"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#AA00FF"
            android:textColor="@android:color/white" />

        <!-- Survival button -->
        <Button
            android:id="@+id/btn_survival"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:text="@string/survival_mode"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#795548"
            android:textColor="@android:color/white" />

        <!-- Arena button -->
        <Button
            android:id="@+id/btn_arena"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:text="@string/arena_mode"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#F57C00"
            android:textColor="@android:color/white" />

        <!-- Ironman button -->
        <Button
            android:id="@+id/btn_ironman"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:text="@string/ironman_mode"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#B71C1C"
            android:textColor="@android:color/white" />

        <!-- Loadout button -->
        <Button
            android:id="@+id/btn_loadout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:text="@string/loadout_mode"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#00838F"
            android:textColor="@android:color/white" />

    </LinearLayout>

    <!-- Settings button -->
    <Button
        android:id="@+id/btn_settings"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:text="@string/settings"
        android:textSize="16sp"
        android:textColor="@color/text_secondary" />

    <!-- Skill Tree button -->
    <Button
        android:id="@+id/btn_skill_tree"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="@string/skill_tree"
        android:textSize="16sp"
        android:backgroundTint="#00E5FF"
        android:textColor="@color/bg_dark" />

    <!-- Statistics button -->
    <Button
        android:id="@+id/btn_stats"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="@string/statistics"
        android:textSize="16sp"
        android:textColor="@color/text_secondary" />

    <!-- Achievements button -->
    <Button
        android:id="@+id/btn_achievements"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="@string/achievements"
        android:textSize="16sp"
        android:textColor="@color/text_secondary" />

    <!-- Daily Challenge button -->
    <Button
        android:id="@+id/btn_daily"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="@string/daily_challenge"
        android:textSize="16sp"
        android:backgroundTint="#FFAB00"
        android:textColor="@color/bg_dark" />

    <!-- Help button -->
    <Button
        android:id="@+id/btn_help"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="@string/help_mechanics"
        android:textSize="16sp"
        android:textColor="@color/text_secondary" />

    <!-- Run History button -->
    <Button
        android:id="@+id/btn_history"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:text="\uD83D\uDCDC Run History"
        android:textSize="16sp"
        android:textColor="@color/text_secondary" />

    <!-- Diamond counter -->
    <TextView
        android:id="@+id/text_diamonds"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#00E5FF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="8dp" />

    <!-- Beta tester banner — shown only in debug builds via code -->
    <LinearLayout
        android:id="@+id/beta_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#33FF9800"
        android:padding="12dp"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\uD83E\uDDEA BETA BUILD"
            android:textColor="#FF9800"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thanks for testing! Report bugs to rogal01."
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Copyright -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="© 2025–2026 rogal01 · MIT License"
        android:textColor="#666666"
        android:textSize="11sp"
        android:gravity="center"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="24dp" />

</LinearLayout>
</ScrollView>

<!-- Floating Daily Reward calendar button -->
<Button
    android:id="@+id/btn_daily_reward"
    android:layout_width="56dp"
    android:layout_height="56dp"
    android:layout_gravity="top|end"
    android:layout_marginTop="12dp"
    android:layout_marginEnd="12dp"
    android:text="📅"
    android:textSize="24sp"
    android:backgroundTint="#FF6F00"
    android:elevation="8dp"
    android:padding="0dp"
    android:minWidth="0dp"
    android:minHeight="0dp" />

</FrameLayout>
