<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_glass"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Header: Title & Close -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_dialog_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="🗺️ SELECT BATTLEFIELD"
                android:textColor="@color/gold"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_close_dialog"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_hud_chip"
                android:gravity="center"
                android:text="✕"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Difficulty Selection -->
        <TextView
            android:id="@+id/tv_diff_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚔️ RUN DIFFICULTY"
            android:textColor="#90A4AE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btn_diff_easy"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_inactive"
                android:text="Easy"
                android:textColor="#B0BEC5"
                android:textSize="12sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_diff_normal"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_tab_active"
                android:text="Normal"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_diff_hard"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_tab_inactive"
                android:text="Hard"
                android:textColor="#B0BEC5"
                android:textSize="12sp"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Map Biomes Horizontal Selector -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌍 ENVIRONMENT BIOMES"
            android:textColor="#90A4AE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginTop="14dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="6dp">

            <LinearLayout
                android:id="@+id/container_biome_tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <!-- Programmatically populated or interactive biome tabs -->
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Path Topology Selector -->
        <TextView
            android:id="@+id/tv_topology_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛣️ PATH TOPOLOGY"
            android:textColor="#90A4AE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="6dp">

            <LinearLayout
                android:id="@+id/container_topology_tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Topology Description & Reroll Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/tv_topology_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Traditional tactical layout tailored to the specific biome environment."
                android:textColor="#B0BEC5"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_reroll_seed"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_hud_chip"
                android:text="🎲 Reroll"
                android:textColor="#FFD54F"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Live Minimap Preview -->
        <com.example.myapp.game.MapPreviewView
            android:id="@+id/map_preview_view"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="10dp" />

        <!-- Selected Map Info Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#201E2E42"
            android:padding="12dp"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/tv_map_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🗺️ Classic"
                android:textColor="@color/gold"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Tactical Badges Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/tv_lane_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hud_chip"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="8dp"
                    android:text="⚔️ 3 Lanes"
                    android:textColor="#00E5FF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_tactical_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_hud_chip"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="8dp"
                    android:text="Balanced 3-Lane Front"
                    android:textColor="#FFD54F"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_map_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Lush kingdom meadows with 3 balanced approach lanes. Ideal proving ground for well-rounded defensive layouts."
                android:textColor="#CFD8DC"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/btn_cancel_dialog"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_action"
                android:text="Cancel"
                android:textColor="#CFD8DC"
                android:textSize="14sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_start_run"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="2"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_btn_green"
                android:text="⚔️ START RUN"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
