<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_glass"
    android:padding="16dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_toStartOf="@id/btn_tutorial_close">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📖 Tactical Field Guide"
                android:textColor="@color/gold"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_chapter_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chapter 1: Hero &amp; Base Defense"
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_tutorial_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_hud_chip"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Horizontal Category Tabs -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/tab_basics"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_tab_active"
                android:text="🛡️ Basics"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:paddingHorizontal="12dp" />

            <Button
                android:id="@+id/tab_towers"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_tab_inactive"
                android:text="🏹 Towers"
                android:textColor="#B0BEC5"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:paddingHorizontal="12dp" />

            <Button
                android:id="@+id/tab_powers"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_tab_inactive"
                android:text="⚡ Spells &amp; Traps"
                android:textColor="#B0BEC5"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:paddingHorizontal="12dp" />

            <Button
                android:id="@+id/tab_monsters"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_tab_inactive"
                android:text="👹 Weaknesses"
                android:textColor="#B0BEC5"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:paddingHorizontal="12dp" />

            <Button
                android:id="@+id/tab_progression"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_tab_inactive"
                android:text="💎 Upgrades"
                android:textColor="#B0BEC5"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:paddingHorizontal="12dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Scrollable Content Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:layout_marginTop="12dp"
        android:background="#20101824"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/tutorial_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Navigation & Bottom Actions -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/text_step_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="● ○ ○ ○ ○"
            android:textColor="#00E5FF"
            android:textSize="14sp"
            android:letterSpacing="0.2" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_tutorial_prev"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_btn_action"
                android:text="Previous"
                android:textColor="#CFD8DC"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:paddingHorizontal="14dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_tutorial_next"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_btn_green"
                android:text="Next Chapter ➔"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:paddingHorizontal="16dp" />
        </LinearLayout>
    </RelativeLayout>

</LinearLayout>
