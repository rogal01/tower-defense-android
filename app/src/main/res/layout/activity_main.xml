<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Game Canvas -->
    <com.example.myapp.game.GameView
        android:id="@+id/game_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top HUD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FF1B2838"
        android:padding="8dp"
        android:gravity="center_vertical">
        <Button
            android:id="@+id/btn_tutorial"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="?"
            android:textSize="18sp"
            android:backgroundTint="#42A5F5"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/text_gold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="\uD83D\uDCB0 50"
            android:textColor="#FFD700"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_wave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="\u2694\uFE0F Wave 0"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/text_kills"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="\uD83D\uDC80 0"
            android:textColor="#AAAACC"
            android:textSize="16sp"
            android:gravity="end" />

        <Button
            android:id="@+id/btn_speed"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="52dp"
            android:layout_marginStart="6dp"
            android:text="\u25B6\uFE0F 2x"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:backgroundTint="#00897B"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_speed3"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="52dp"
            android:layout_marginStart="2dp"
            android:text="\u23E9 3x"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:backgroundTint="#00695C"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_auto_wave"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="52dp"
            android:layout_marginStart="2dp"
            android:text="⏭ Auto"
            android:textSize="11sp"
            android:textStyle="bold"
            android:backgroundTint="#455A64"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_pause"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="52dp"
            android:layout_marginStart="2dp"
            android:text="\u23F8\uFE0F"
            android:textSize="11sp"
            android:textStyle="bold"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Bottom Controls — scrollable organized panels -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#FF1B2838">

        <!-- Row 1: Towers — horizontally scrollable with readable names -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:fadingEdgeLength="16dp"
            android:requiresFadingEdge="horizontal">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp"
                android:paddingVertical="3dp"
                android:gravity="center">

                <Button
                    android:id="@+id/btn_tower_arrow"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:minWidth="90dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\uD83C\uDFF9 Arrow\n30g"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#4CAF50"
                    android:paddingHorizontal="8dp" />

                <Button
                    android:id="@+id/btn_tower_magic"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:minWidth="90dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\uD83E\uDDE8 Magic\n60g"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#AB47BC"
                    android:paddingHorizontal="8dp" />

                <Button
                    android:id="@+id/btn_tower_cannon"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:minWidth="90dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\uD83D\uDCA3 Cannon\n100g"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#FF7043"
                    android:paddingHorizontal="8dp" />

                <Button
                    android:id="@+id/btn_tower_poison"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:minWidth="90dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\u2620\uFE0F Poison\n80g"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#66BB6A"
                    android:paddingHorizontal="8dp" />

                <Button
                    android:id="@+id/btn_tower_tesla"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:minWidth="90dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\u26A1 Tesla\n120g"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:textColor="#1B2838"
                    android:backgroundTint="#29B6F6"
                    android:paddingHorizontal="8dp" />

                <Button
                    android:id="@+id/btn_tower_ice"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:minWidth="90dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\u2744\uFE0F Ice\n70g"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#81D4FA"
                    android:textColor="#1B2838"
                    android:paddingHorizontal="8dp" />

                <Button
                    android:id="@+id/btn_tower_flame"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:minWidth="90dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\uD83D\uDD25 Flame\n90g"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#FF5722"
                    android:paddingHorizontal="8dp" />

                <Button
                    android:id="@+id/btn_tower_necro"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:minWidth="90dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\uD83D\uDC80 Necro\n110g"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#9C27B0"
                    android:paddingHorizontal="8dp" />

                <Button
                    android:id="@+id/btn_tower_ballista"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:minWidth="90dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\uD83C\uDFAF Ballista\n140g"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#FFD54F"
                    android:textColor="#1B2838"
                    android:paddingHorizontal="8dp" />

                <Button
                    android:id="@+id/btn_tower_vortex"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:minWidth="90dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\uD83C\uDF00 Vortex\n100g"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#7E57C2"
                    android:paddingHorizontal="8dp" />

                <Button
                    android:id="@+id/btn_tower_healer"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:minWidth="90dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\uD83D\uDC9A Healer\n80g"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#66BB6A"
                    android:paddingHorizontal="8dp" />

                <Button
                    android:id="@+id/btn_repair"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:minWidth="80dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\uD83D\uDD27 Repair\n20g"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#26A69A"
                    android:paddingHorizontal="8dp" />

                <Button
                    android:id="@+id/btn_blockade"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:minWidth="80dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\uD83E\uDEA8 Block\n50g"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#8D6E63"
                    android:paddingHorizontal="8dp" />

                <Button
                    android:id="@+id/btn_trap_spike"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:minWidth="80dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\uD83D\uDDE1\uFE0F Spike\n30g"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#757575"
                    android:paddingHorizontal="8dp" />

                <Button
                    android:id="@+id/btn_trap_tar"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:minWidth="80dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\uD83D\uDFE4 Tar\n40g"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#5D4037"
                    android:paddingHorizontal="8dp" />

                <Button
                    android:id="@+id/btn_trap_mine"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:minWidth="80dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\uD83D\uDCA3 Mine\n60g"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#E53935"
                    android:paddingHorizontal="8dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Row 2: Upgrades + Actions — scrollable -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:fadingEdgeLength="16dp"
            android:requiresFadingEdge="horizontal">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"
                android:gravity="center">

                <Button
                    android:id="@+id/btn_up_damage"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:minWidth="72dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\u2694\uFE0F ATK"
                    android:textSize="10sp"
                    android:textAllCaps="false"
                    android:gravity="center"
                    android:paddingHorizontal="6dp"
                    android:backgroundTint="#42A5F5" />

                <Button
                    android:id="@+id/btn_up_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:minWidth="72dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\uD83D\uDC5F SPD"
                    android:textSize="10sp"
                    android:textAllCaps="false"
                    android:gravity="center"
                    android:paddingHorizontal="6dp"
                    android:backgroundTint="#42A5F5" />

                <Button
                    android:id="@+id/btn_up_hp"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:minWidth="72dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\u2764\uFE0F HP"
                    android:textSize="10sp"
                    android:textAllCaps="false"
                    android:gravity="center"
                    android:paddingHorizontal="6dp"
                    android:backgroundTint="#42A5F5" />

                <Button
                    android:id="@+id/btn_up_base"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:minWidth="72dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\uD83C\uDFF0 BASE"
                    android:textSize="10sp"
                    android:textAllCaps="false"
                    android:gravity="center"
                    android:paddingHorizontal="6dp"
                    android:backgroundTint="#42A5F5" />

                <Button
                    android:id="@+id/btn_up_tower"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:minWidth="80dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\u2B06\uFE0F TOWER"
                    android:textSize="10sp"
                    android:textAllCaps="false"
                    android:gravity="center"
                    android:paddingHorizontal="6dp"
                    android:backgroundTint="#FFB300"
                    android:textColor="#1B2838" />

                <Button
                    android:id="@+id/btn_target"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="76dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\uD83C\uDFAF Close"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#26A69A" />

                <Button
                    android:id="@+id/btn_sell"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="72dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\uD83D\uDCB8 Sell"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#EF5350" />

                <Button
                    android:id="@+id/btn_ability"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="80dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\u2728 Ability"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#FF8F00" />

            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Powers Bar — vertical on right side -->
    <LinearLayout
        android:id="@+id/powers_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:orientation="vertical"
        android:padding="4dp"
        android:background="#CC1B2838"
        android:gravity="center">
        <Button
            android:id="@+id/btn_power_fireball"
            android:layout_width="52dp"
            android:layout_height="44dp"
            android:text="\uD83D\uDD25"
            android:textSize="16sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:layout_marginBottom="4dp"
            android:backgroundTint="#FF7043" />
        <Button
            android:id="@+id/btn_power_freeze"
            android:layout_width="52dp"
            android:layout_height="44dp"
            android:text="\u2744\uFE0F"
            android:textSize="16sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:layout_marginBottom="4dp"
            android:backgroundTint="#42A5F5" />
        <Button
            android:id="@+id/btn_power_lightning"
            android:layout_width="52dp"
            android:layout_height="44dp"
            android:text="\u26A1"
            android:textSize="16sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:layout_marginBottom="4dp"
            android:textColor="#1B2838"
            android:backgroundTint="#FFD700" />
        <Button
            android:id="@+id/btn_dash"
            android:layout_width="52dp"
            android:layout_height="44dp"
            android:text="\uD83D\uDCA8"
            android:textSize="16sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#00BFA5" />
    </LinearLayout>

</FrameLayout>
