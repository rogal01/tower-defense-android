<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Game Canvas -->
    <com.example.myapp.game.GameView
        android:id="@+id/game_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top HUD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#CC1B2838"
        android:padding="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/text_gold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="\uD83D\uDCB0 50"
            android:textColor="#FFD700"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_wave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="\u2694\uFE0F Wave 0"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/text_kills"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="\uD83D\uDC80 0"
            android:textColor="#AAAACC"
            android:textSize="16sp"
            android:gravity="end" />
    </LinearLayout>

    <!-- Powers Bar -->
    <LinearLayout
        android:id="@+id/powers_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        android:orientation="horizontal"
        android:background="#CC1B2838"
        android:padding="4dp"
        android:gravity="center">
        <Button
            android:id="@+id/btn_power_fireball"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="\uD83D\uDD25 Fire"
            android:textSize="11sp"
            android:backgroundTint="#FF7043" />
        <Button
            android:id="@+id/btn_power_freeze"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="\u2744\uFE0F Freeze"
            android:textSize="11sp"
            android:backgroundTint="#42A5F5" />
        <Button
            android:id="@+id/btn_power_heal"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="\uD83D\uDC9A Heal"
            android:textSize="11sp"
            android:backgroundTint="#4CAF50" />
        <Button
            android:id="@+id/btn_power_lightning"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="\u26A1 Zap"
            android:textSize="11sp"
            android:textColor="#1B2838"
            android:backgroundTint="#FFD700" />
        <Button
            android:id="@+id/btn_dash"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="\uD83D\uDCA8 Dash"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#00BFA5" />
    </LinearLayout>

    <!-- Bottom Controls — scrollable organized panels -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#DD1B2838">

        <!-- Row 1: Towers — horizontally scrollable with readable names -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:fadingEdgeLength="16dp"
            android:requiresFadingEdge="horizontal">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp"
                android:paddingVertical="3dp"
                android:gravity="center">

                <Button
                    android:id="@+id/btn_tower_arrow"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:minWidth="90dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\uD83C\uDFF9 Arrow\n30g"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#4CAF50"
                    android:paddingHorizontal="8dp" />

                <Button
                    android:id="@+id/btn_tower_magic"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:minWidth="90dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\uD83E\uDDE8 Magic\n60g"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#AB47BC"
                    android:paddingHorizontal="8dp" />

                <Button
                    android:id="@+id/btn_tower_cannon"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:minWidth="90dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\uD83D\uDCA3 Cannon\n100g"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#FF7043"
                    android:paddingHorizontal="8dp" />

                <Button
                    android:id="@+id/btn_tower_poison"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:minWidth="90dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\u2620\uFE0F Poison\n80g"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#66BB6A"
                    android:paddingHorizontal="8dp" />

                <Button
                    android:id="@+id/btn_tower_tesla"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:minWidth="90dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\u26A1 Tesla\n120g"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:textColor="#1B2838"
                    android:backgroundTint="#29B6F6"
                    android:paddingHorizontal="8dp" />

                <Button
                    android:id="@+id/btn_tower_ice"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:minWidth="90dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\u2744\uFE0F Ice\n70g"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#81D4FA"
                    android:textColor="#1B2838"
                    android:paddingHorizontal="8dp" />

                <Button
                    android:id="@+id/btn_repair"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:minWidth="80dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\uD83D\uDD27 Repair\n20g"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#26A69A"
                    android:paddingHorizontal="8dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Row 2: Upgrades + Actions — scrollable -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:fadingEdgeLength="16dp"
            android:requiresFadingEdge="horizontal">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"
                android:gravity="center">

                <Button
                    android:id="@+id/btn_up_damage"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="72dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\u2694\uFE0F ATK"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#42A5F5" />

                <Button
                    android:id="@+id/btn_up_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="72dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\uD83D\uDC5F SPD"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#42A5F5" />

                <Button
                    android:id="@+id/btn_up_hp"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="72dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\u2764\uFE0F HP"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#42A5F5" />

                <Button
                    android:id="@+id/btn_up_base"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="72dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\uD83C\uDFF0 BASE"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#42A5F5" />

                <Button
                    android:id="@+id/btn_up_tower"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="80dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\u2B06\uFE0F TOWER"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#FFB300"
                    android:textColor="#1B2838" />

                <Button
                    android:id="@+id/btn_target"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="76dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\uD83C\uDFAF Close"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#26A69A" />

                <Button
                    android:id="@+id/btn_sell"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="72dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\uD83D\uDCB8 Sell"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#EF5350" />

                <Button
                    android:id="@+id/btn_ability"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="80dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\u2728 Ability"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#FF8F00" />

                <Button
                    android:id="@+id/btn_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="64dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\u25B6\uFE0F 1x"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:backgroundTint="#00897B" />

                <Button
                    android:id="@+id/btn_pause"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="52dp"
                    android:layout_marginHorizontal="2dp"
                    android:text="\u23F8\uFE0F"
                    android:textSize="11sp"
                    android:backgroundTint="#546E7A" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

</FrameLayout>
