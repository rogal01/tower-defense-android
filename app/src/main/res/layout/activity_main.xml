<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Game Canvas -->
    <com.example.myapp.game.GameView
        android:id="@+id/game_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top HUD — Modern translucent Obsidian Glass status bar -->
    <LinearLayout
        android:id="@+id/top_hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_top_hud_obsidian"
        android:paddingHorizontal="8dp"
        android:paddingVertical="5dp"
        android:gravity="center_vertical"
        android:elevation="8dp">

        <Button
            android:id="@+id/btn_tutorial"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="?"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_hud_glow"
            android:padding="0dp"
            android:minWidth="32dp"
            android:minHeight="32dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_codex"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="⚗️"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_hud_glow"
            android:padding="0dp"
            android:minWidth="32dp"
            android:minHeight="32dp"
            android:layout_marginEnd="6dp" />

        <!-- Gold Status Capsule -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_hud_capsule_gold"
            android:paddingHorizontal="10dp"
            android:layout_marginEnd="4dp">
            <TextView
                android:id="@+id/text_gold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💰 50"
                android:textColor="@color/gold"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Wave Status Capsule -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_hud_capsule"
            android:paddingHorizontal="9dp"
            android:layout_marginEnd="4dp">
            <TextView
                android:id="@+id/text_wave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚔️ Wave 0"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Kills Capsule -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_hud_capsule_ruby"
            android:paddingHorizontal="8dp"
            android:layout_marginEnd="4dp">
            <TextView
                android:id="@+id/text_kills"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💀 0"
                android:textColor="#FF8A80"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Diamonds Capsule -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_hud_capsule_cyan"
            android:paddingHorizontal="8dp"
            android:layout_marginEnd="6dp">
            <TextView
                android:id="@+id/text_diamonds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💎 0"
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Segmented Controls Container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_speed"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="44dp"
                android:text="1x"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_segmented_btn_left"
                android:textColor="@color/gold"
                android:padding="0dp" />

            <Button
                android:id="@+id/btn_call_wave"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="52dp"
                android:text="▶▶ Rush"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_segmented_btn_mid"
                android:textColor="@color/gold"
                android:padding="0dp" />

            <Button
                android:id="@+id/btn_auto_wave"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="46dp"
                android:text="Auto"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_segmented_btn_mid"
                android:textColor="#B0BEC5"
                android:padding="0dp" />

            <Button
                android:id="@+id/btn_pause"
                android:layout_width="34dp"
                android:layout_height="32dp"
                android:text="⏸"
                android:textSize="12sp"
                android:background="@drawable/bg_segmented_btn_right"
                android:textColor="#FFFFFF"
                android:padding="0dp"
                android:minWidth="34dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Floating Powers Bar — Vertical on right side -->
    <LinearLayout
        android:id="@+id/powers_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:orientation="vertical"
        android:padding="6dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_card_glass"
        android:elevation="6dp"
        android:gravity="center">

        <com.example.myapp.game.HeroPowerOrbView
            android:id="@+id/btn_power_fireball"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="🔥"
            android:textSize="20sp"
            android:padding="0dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:layout_marginBottom="8dp" />

        <com.example.myapp.game.HeroPowerOrbView
            android:id="@+id/btn_power_freeze"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="❄️"
            android:textSize="20sp"
            android:padding="0dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:layout_marginBottom="8dp" />

        <com.example.myapp.game.HeroPowerOrbView
            android:id="@+id/btn_power_heal"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="💚"
            android:textSize="20sp"
            android:padding="0dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:layout_marginBottom="8dp" />

        <com.example.myapp.game.HeroPowerOrbView
            android:id="@+id/btn_power_lightning"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="⚡"
            android:textSize="20sp"
            android:padding="0dp"
            android:minWidth="48dp"
            android:minHeight="48dp" />
    </LinearLayout>

    <!-- Bottom Controls Area -->
    <FrameLayout
        android:id="@+id/bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:elevation="8dp">

        <!-- 1. Active Placement Bar (Shown during placement mode) -->
        <LinearLayout
            android:id="@+id/layout_placement_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_glass"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/text_placement_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Placing: Arrow Tower (30g)"
                android:textColor="@color/gold"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingStart="4dp" />

            <Button
                android:id="@+id/btn_cancel_placement"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="✕ Anuluj / Cancel"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_danger"
                android:paddingHorizontal="16dp" />
        </LinearLayout>

        <!-- 2. Selected Tower Inspector Card (Shown when a tower is selected) -->
        <LinearLayout
            android:id="@+id/layout_tower_inspector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_inspector_modern"
            android:paddingHorizontal="10dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <!-- Inspector Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="4dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/inspector_tower_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⭐ Lv.1 Arrow Tower"
                    android:textColor="@color/gold"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/inspector_tower_stats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_inspector_close"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="✕"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_btn_action"
                    android:padding="0dp"
                    android:minWidth="32dp"
                    android:minHeight="32dp" />
            </LinearLayout>

            <!-- 4 Compact Stat Badges -->
            <LinearLayout
                android:id="@+id/layout_tower_stats_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingHorizontal="2dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/badge_stat_dmg"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/bg_hud_capsule"
                    android:gravity="center"
                    android:text="⚔️ 20"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/badge_stat_rng"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/bg_hud_capsule"
                    android:gravity="center"
                    android:text="🎯 140"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/badge_stat_spd"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/bg_hud_capsule"
                    android:gravity="center"
                    android:text="⚡ 1.2/s"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/badge_stat_kills"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/bg_hud_capsule"
                    android:gravity="center"
                    android:text="💀 0"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Inspector Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btn_up_tower"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:text="▲ Lv.2 [+14 DMG] [💰 45]"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_btn_gold"
                    android:textColor="#FFFFFF"
                    android:padding="2dp" />

                <Button
                    android:id="@+id/btn_target"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:text="🎯 Target\nClose"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_chip_target"
                    android:textColor="#FFFFFF"
                    android:padding="2dp" />

                <Button
                    android:id="@+id/btn_ability"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:text="✨ Ability"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_btn_action"
                    android:textColor="@color/gold"
                    android:padding="2dp" />

                <Button
                    android:id="@+id/btn_sell"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:text="💸 Sell\n+25g"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_btn_danger"
                    android:textColor="#FFFFFF"
                    android:padding="2dp" />
            </LinearLayout>

            <!-- Specialization Row (Level 5+) -->
            <LinearLayout
                android:id="@+id/layout_tower_spec"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="6dp"
                android:visibility="gone">

                <Button
                    android:id="@+id/btn_specialize"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="⚡ Choose Specialization!"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_btn_green"
                    android:padding="0dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3. Categorized Build & Upgrade Dock (Default bottom view) -->
        <LinearLayout
            android:id="@+id/layout_build_dock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_glass"
            android:paddingBottom="4dp">

            <!-- Category Tabs Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingTop="3dp"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/tab_towers"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:text="🏹 Towers"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_tab_active"
                    android:textColor="#FFFFFF"
                    android:padding="0dp"
                    android:minHeight="0dp" />

                <Button
                    android:id="@+id/tab_traps"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:text="💣 Traps"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_tab_inactive"
                    android:textColor="#B0BEC5"
                    android:padding="0dp"
                    android:minHeight="0dp" />

                <Button
                    android:id="@+id/tab_hero"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:text="⚔️ Hero"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_tab_inactive"
                    android:textColor="#B0BEC5"
                    android:padding="0dp"
                    android:minHeight="0dp" />
            </LinearLayout>

            <!-- Container 1: Towers Carousel -->
            <HorizontalScrollView
                android:id="@+id/container_towers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingHorizontal="4dp"
                android:paddingVertical="4dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/btn_tower_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:minWidth="84dp"
                        android:layout_marginHorizontal="2dp"
                        android:text="🏹 Arrow\n30g"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:background="@drawable/bg_tower_card"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="8dp" />

                    <Button
                        android:id="@+id/btn_tower_magic"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:minWidth="84dp"
                        android:layout_marginHorizontal="2dp"
                        android:text="🧨 Magic\n60g"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:background="@drawable/bg_tower_card"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="8dp" />

                    <Button
                        android:id="@+id/btn_tower_cannon"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:minWidth="84dp"
                        android:layout_marginHorizontal="2dp"
                        android:text="💣 Cannon\n100g"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:background="@drawable/bg_tower_card"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="8dp" />

                    <Button
                        android:id="@+id/btn_tower_poison"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:minWidth="84dp"
                        android:layout_marginHorizontal="2dp"
                        android:text="☠️ Poison\n80g"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:background="@drawable/bg_tower_card"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="8dp" />

                    <Button
                        android:id="@+id/btn_tower_tesla"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:minWidth="84dp"
                        android:layout_marginHorizontal="2dp"
                        android:text="⚡ Tesla\n120g"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:background="@drawable/bg_tower_card"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="8dp" />

                    <Button
                        android:id="@+id/btn_tower_ice"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:minWidth="84dp"
                        android:layout_marginHorizontal="2dp"
                        android:text="❄️ Ice\n50g"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:background="@drawable/bg_tower_card"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="8dp" />

                    <Button
                        android:id="@+id/btn_tower_flame"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:minWidth="84dp"
                        android:layout_marginHorizontal="2dp"
                        android:text="🔥 Flame\n90g"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:background="@drawable/bg_tower_card"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="8dp" />

                    <Button
                        android:id="@+id/btn_tower_necro"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:minWidth="84dp"
                        android:layout_marginHorizontal="2dp"
                        android:text="💀 Necro\n150g"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:background="@drawable/bg_tower_card"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="8dp" />

                    <Button
                        android:id="@+id/btn_tower_ballista"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:minWidth="84dp"
                        android:layout_marginHorizontal="2dp"
                        android:text="🎯 Ballista\n130g"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:background="@drawable/bg_tower_card"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="8dp" />

                    <Button
                        android:id="@+id/btn_tower_vortex"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:minWidth="84dp"
                        android:layout_marginHorizontal="2dp"
                        android:text="🌀 Vortex\n140g"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:background="@drawable/bg_tower_card"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="8dp" />

                    <Button
                        android:id="@+id/btn_tower_healer"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:minWidth="84dp"
                        android:layout_marginHorizontal="2dp"
                        android:text="💚 Healer\n110g"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:background="@drawable/bg_tower_card"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="8dp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Container 2: Traps & Fortifications -->
            <HorizontalScrollView
                android:id="@+id/container_traps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingHorizontal="4dp"
                android:paddingVertical="4dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/btn_repair"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:minWidth="84dp"
                        android:layout_marginHorizontal="2dp"
                        android:text="🔧 Repair\n40g"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:background="@drawable/bg_tower_card"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="8dp" />

                    <Button
                        android:id="@+id/btn_blockade"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:minWidth="84dp"
