<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_glass"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Result Badge Icon -->
        <TextView
            android:id="@+id/result_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏆"
            android:textSize="44sp"
            android:gravity="center" />

        <!-- Title -->
        <TextView
            android:id="@+id/result_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REALM DEFENDED!"
            android:textColor="@color/gold"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            android:gravity="center" />

        <!-- Subtitle / Mode Info -->
        <TextView
            android:id="@+id/result_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mission 1: The Basics"
            android:textColor="#B0BEC5"
            android:textSize="13sp"
            android:layout_marginTop="2dp"
            android:gravity="center" />

        <!-- Star Rating Display (for campaign) -->
        <LinearLayout
            android:id="@+id/layout_stars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/result_stars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭐ ⭐ ⭐"
                android:textSize="26sp"
                android:gravity="center" />
        </LinearLayout>

        <!-- Objectives Checklist (for campaign) -->
        <LinearLayout
            android:id="@+id/layout_objectives"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hud_chip"
            android:padding="12dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📜 Mission Objectives"
                android:textColor="@color/gold"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/result_obj1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ Clear Wave 3"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/result_obj2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ Score ≥ 120"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:layout_marginTop="3dp" />

            <TextView
                android:id="@+id/result_obj3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ Score ≥ 250"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <!-- Stats Chips Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp">

            <!-- Row 1: Waves & Score -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/stat_waves"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_hud_chip"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="🌊 Wave 3/3"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/stat_score"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_hud_chip"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="🎯 1,450 pts"
                    android:textColor="@color/gold"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- Row 2: Kills & Combo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/stat_kills"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_hud_chip"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="⚔️ 48 Slain"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/stat_combo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_hud_chip"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="🔥 12x Combo"
                    android:textColor="#FF9100"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- Row 3: Diamonds & Bosses -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/stat_diamonds"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_hud_chip"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="💎 +5 Diamonds"
                    android:textColor="#00E5FF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/stat_bosses"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_hud_chip"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="👑 1 Boss"
                    android:textColor="#E040FB"
                    android:textSize="13sp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Reward Banner -->
        <TextView
            android:id="@+id/result_reward_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hud_chip"
            android:gravity="center"
            android:padding="8dp"
            android:text="✨ +5 Diamonds added to Vault!"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp" />

        <!-- Action Buttons -->
        <Button
            android:id="@+id/btn_next_mission"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_green"
            android:text="▶ Next Mission"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btn_play_again"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_primary"
            android:text="🔄 Play Again"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btn_menu"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_action"
            android:text="📜 Campaign Map"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>
