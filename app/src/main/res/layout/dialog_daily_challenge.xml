<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_glass"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header: Title & Close -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_toStartOf="@id/btn_daily_close">

                <TextView
                    android:id="@+id/daily_trial_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅 Trial of the Crimson Eclipse"
                    android:textColor="@color/gold"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/daily_trial_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today's Trial • 15 Waves to Victory"
                    android:textColor="#00E5FF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_daily_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_hud_chip"
                android:gravity="center"
                android:text="✕"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Metadata Chips Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/chip_daily_map"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_hud_chip"
                android:paddingVertical="6dp"
                android:paddingHorizontal="6dp"
                android:gravity="center"
                android:text="🌲 Classic"
                android:textColor="#CFD8DC"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chip_daily_gold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_hud_chip"
                android:paddingVertical="6dp"
                android:paddingHorizontal="6dp"
                android:gravity="center"
                android:text="💰 60 Gold"
                android:textColor="#CFD8DC"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chip_daily_reward"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_hud_chip"
                android:paddingVertical="6dp"
                android:paddingHorizontal="6dp"
                android:gravity="center"
                android:text="💎 +10 Diamonds"
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Modifiers Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ ACTIVE WAVE MODIFIERS"
            android:textColor="#FFD700"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp" />

        <!-- Dynamic Modifiers Container -->
        <LinearLayout
            android:id="@+id/container_daily_modifiers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Trial Rule Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hud_chip"
            android:padding="10dp"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/daily_twist_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ Enemy Scaling Twist"
                android:textColor="#FFA726"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/daily_twist_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enemies have modified HP and speed for this trial. Modifiers rotate each wave."
                android:textColor="#B0BEC5"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">

            <Button
                android:id="@+id/btn_daily_cancel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Cancel"
                android:textColor="#CFD8DC"
                android:background="@drawable/bg_hud_chip" />

            <Button
                android:id="@+id/btn_daily_deploy"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="2"
                android:layout_marginStart="10dp"
                android:text="⚔️ DEPLOY TO TRIAL"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_green" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
