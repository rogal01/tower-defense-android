<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_glass"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:id="@+id/spec_dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ Tower Specialization"
            android:textColor="@color/gold"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/spec_tower_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hud_chip"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="🏹 Arrow Tower · Level 5 Mastery"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select a permanent specialization branch for this defense post:"
            android:textColor="#B0BEC5"
            android:textSize="13sp"
            android:layout_marginTop="8dp" />

        <!-- Branch 1 Container -->
        <LinearLayout
            android:id="@+id/card_spec_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_buff_gold"
            android:padding="14dp"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/spec_1_emoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎯"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/spec_1_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sniper"
                    android:textColor="@color/gold"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/spec_1_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="+60 range, 2.5x critical headshot chance"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:layout_marginTop="6dp" />

            <Button
                android:id="@+id/btn_choose_spec_1"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_btn_green"
                android:text="CHOOSE PATH"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- Branch 2 Container -->
        <LinearLayout
            android:id="@+id/card_spec_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_buff_cyan"
            android:padding="14dp"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/spec_2_emoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏹"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/spec_2_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ranger"
                    android:textColor="#00E5FF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/spec_2_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fires 3 arrows simultaneously in a volley"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:layout_marginTop="6dp" />

            <Button
                android:id="@+id/btn_choose_spec_2"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_btn_primary"
                android:text="CHOOSE PATH"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- Cancel / Dismiss Button -->
        <Button
            android:id="@+id/btn_spec_cancel"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_action"
            android:text="Cancel"
            android:textColor="#B0BEC5"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="14dp" />
    </LinearLayout>
</ScrollView>
