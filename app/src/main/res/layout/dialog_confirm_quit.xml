<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_glass"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🛡️"
        android:textSize="38sp" />

    <TextView
        android:id="@+id/quit_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Abandon Battle?"
        android:textColor="@color/gold"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp"
        android:gravity="center" />

    <TextView
        android:id="@+id/quit_dialog_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your current defense progress will be logged to Run History."
        android:textColor="#B0BEC5"
        android:textSize="13sp"
        android:layout_marginTop="6dp"
        android:gravity="center" />

    <TextView
        android:id="@+id/quit_dialog_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hud_chip"
        android:padding="10dp"
        android:gravity="center"
        android:text="🌊 Wave 5  ·  🎯 Score 680"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/btn_resume_run"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_btn_green"
        android:text="🛡️ Hold the Line (Resume)"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btn_confirm_abandon"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_btn_danger"
        android:text="🏳️ Surrender &amp; Return"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp" />
</LinearLayout>
