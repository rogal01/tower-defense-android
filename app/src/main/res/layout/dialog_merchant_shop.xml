<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_glass"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛒"
            android:textSize="36sp" />

        <TextView
            android:id="@+id/merchant_dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="THE WANDERING MERCHANT"
            android:textColor="@color/gold"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginTop="2dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/merchant_dialog_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A traveler from the void offers elemental secrets and forbidden pacts. Choose up to one draft ware:"
            android:textColor="#B0BEC5"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/merchant_gold_display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_lang"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="💰 Your Gold: 100g"
            android:textColor="@color/gold"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <!-- Card 1 -->
        <LinearLayout
            android:id="@+id/card_merchant_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hud_chip"
            android:padding="12dp"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/item_tier_badge_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_lang"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="PERMANENT SYNERGY"
                    android:textColor="#AB47BC"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/item_formula_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥 Flame + ❄️ Ice"
                    android:textColor="#00E5FF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/item_emoji_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💥"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/item_title_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thermal Shock"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/item_desc_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hitting chilled enemies with fire or burning enemies with ice causes an explosive 140 AoE shatter burst."
                android:textColor="#CFD8DC"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btn_buy_1"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_btn_green"
                android:text="PURCHASE • 120g"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Card 2 -->
        <LinearLayout
            android:id="@+id/card_merchant_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hud_chip"
            android:padding="12dp"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/item_tier_badge_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_lang"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="HIGH-STAKES PACT"
                    android:textColor="#FF5722"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/item_formula_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="High Risk / High Damage"
                    android:textColor="#FFB74D"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/item_emoji_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🗡️"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/item_title_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Glass Cannon"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/item_desc_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="All towers and hero deal +50% extra damage, but Base Max HP is reduced by 35%."
                android:textColor="#CFD8DC"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btn_buy_2"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_btn_primary"
                android:text="PURCHASE • 80g"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Card 3 -->
        <LinearLayout
            android:id="@+id/card_merchant_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hud_chip"
            android:padding="12dp"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/item_tier_badge_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_lang"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="3-WAVE BOOSTER"
                    android:textColor="#00B0FF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/item_formula_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3 Waves Duration"
                    android:textColor="#80D8FF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/item_emoji_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧪"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/item_title_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alchemist's Draft"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/item_desc_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="+35% Tower attack speed and +20% hero move speed for the next 3 waves."
                android:textColor="#CFD8DC"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btn_buy_3"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_btn_action"
                android:text="PURCHASE • 45g"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_merchant_skip"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_action"
            android:text="SAVE GOLD &amp; CONTINUE"
            android:textColor="#B0BEC5"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="14dp" />

    </LinearLayout>
</ScrollView>
